// The Shoe Company — inventory schema (MongoDB)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// One document per footwear item. The `code` is what you type/scan to look it
// up. Sizes are embedded inside the document (see SizeStock below), so a shoe
// and its stock live together and are deleted together.
model Footwear {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  serial       Int?        @unique // sequential number shown as S1, S2, … (auto-assigned)
  code         String      @unique // e.g. "SPT-115" — the lookup key
  name         String
  category         String // Ladies | Gents | Slipper | Chappal | Formal | Casual | Sports
  genderGroup      String? // optional: Ladies | Gents | Kids
  sellingPrice     Int // current price to the customer, whole rupees e.g. 2499
  purchasePrice    Int? // what the shop paid (cost) — optional, internal
  lastSellingPrice Int? // the price it last sold at — optional
  imageUrl         String? // link to the photo (stored in cloud, not in the DB)
  description  String? // optional
  sizes        SizeStock[] // embedded stock-per-size list
  sales        Sale[] // every sale made of this shoe
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Embedded document: one size (1–12) and its stock quantity.
type SizeStock {
  size     Int // 1 … 12 — kids' sizes start at 1
  quantity Int
}

// One document per sale. Recording a sale reduces the stock of that shoe's
// size by the quantity sold (see app/sales/actions.ts).
//
// The item details (code, serial, name, size) are copied onto the sale so the
// history still reads correctly if the shoe is later renamed or deleted. So is
// costPrice — the monthly profit has to be worked out from what the shop paid
// at the time, not from whatever the cost happens to be today.
model Sale {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  footwearId String   @db.ObjectId
  footwear   Footwear @relation(fields: [footwearId], references: [id])
  code       String // snapshot of the shoe's lookup code, e.g. "SPT-115"
  serial     Int? // snapshot of the shoe's S-number
  itemName   String // snapshot of the shoe's name
  imageUrl   String? // snapshot of the photo, so the list still shows it later
  size       Int // the size that was sold (and reduced from stock)
  quantity   Int // pairs sold
  listPrice  Int? // what the shoe was listed at, copied at the time of sale
  unitPrice  Int // price per pair actually charged, whole rupees
  total      Int // unitPrice * quantity
  costPrice  Int? // what the shop paid per pair, copied at the time of sale
  note       String? // optional remark
  soldAt     DateTime @default(now()) // the day of the sale, chosen on the form
  createdAt  DateTime @default(now()) // when it was entered into the system
}
